<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
        <Content Include="Dockerfile" />
        <Content Include="Resources\Textures\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Resources\Font\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Resources\Textures\sand.png" />
        <Compile Include="Resources\Resources.fs" />
        <Compile Include="Utils\GameRandom.fs" />
        <Compile Include="Utils\MathUtils.fs" />
        <Compile Include="UI\Text\Text.fs" />
        <Compile Include="UI\UISystem.fs" />
        <Compile Include="World\RoomRenderer.fs" />
        <Compile Include="World\Room.fs" />
        <Compile Include="Entity\EntityAnimation.fs" />
        <Compile Include="Entity\Entity.fs" />
        <Compile Include="Entity\ElasticCamera.fs" />
        <Compile Include="Entity\EntityGroup.fs" />
        <Compile Include="Connection\Dto.fs" />
        <Compile Include="Connection\GameConnection.fs" />
        <Compile Include="Connection\PlayerController.fs" />
        <Compile Include="Connection\Synchro.fs" />
        <Compile Include="Game.fs" />
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\LadaEngine\src\LadaEngine\LadaEngine.csproj" />
    </ItemGroup>
</Project>
